<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI definition for FbGateway.

  Built by .github/workflows/release.yml, which passes the version
  from the git tag and the path to the published output:

    wix build installer/Package.wxs -arch x64 ^
      -d Version=1.2.3 -d PublishDir=publish -o FbGateway-1.2.3-x64.msi

  UpgradeCode identifies the product across every release and must
  never change; changing it would make new versions install beside
  the old ones instead of upgrading them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="FbGateway"
           Manufacturer="FbGateway"
           Version="$(var.Version)"
           UpgradeCode="736F45BA-01C2-45C9-98AF-58170F4E9B5D"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of FbGateway is already installed. Uninstall it first to install this version." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="installer/FbGateway.ico" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/kenanwahbeh/FbGateway" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/kenanwahbeh/FbGateway" />

    <!--
      The app needs a desktop session: it is a WPF window that hosts
      the gateway, so a server core install is not a target.
    -->
    <Launch Condition="Installed OR VersionNT &gt;= 603"
            Message="FbGateway requires Windows 8.1 or later." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FbGateway" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="FbGateway" />
    </StandardDirectory>

    <Feature Id="Main" Title="FbGateway" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Harvests the whole published folder; no manual file list. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut"
               Directory="AppMenuFolder"
               Guid="914069B5-97EC-41E4-BE3B-D6EA012353DD">

      <Shortcut Id="AppShortcut"
                Name="FbGateway"
                Description="HTTP gateway for Firebird databases"
                Target="[INSTALLFOLDER]FbGateway.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />

      <RemoveFolder Id="RemoveAppMenuFolder"
                    Directory="AppMenuFolder"
                    On="uninstall" />

      <RegistryValue Root="HKMU"
                     Key="Software\FbGateway"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />

    </Component>

  </Package>

</Wix>
