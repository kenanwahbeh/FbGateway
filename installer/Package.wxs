<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI definition for Easy FB Soft.

  Built by .github/workflows/release.yml, which passes the version
  from the git tag and the folder to package:

    wix build installer/Package.wxs -arch x64 -wx8600 -wx8601 ^
      -pdbtype none -d Version=1.2.3 -d PublishDir=publish ^
      -o EasyFbSoft-1.2.3-x64.msi

  The same file builds both distributions; only PublishDir differs.
  They share one product identity on purpose, so a machine ends up
  with one Easy FB Soft rather than two competing installs. Switching
  between them at the same version means uninstalling first, because
  an MSI major upgrade will not replace an equal version.

  UpgradeCode identifies the product across every release and must
  never change; changing it would make new versions install beside
  the old ones instead of upgrading them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="Easy FB Soft"
           Manufacturer="Easy FB Soft"
           Version="$(var.Version)"
           UpgradeCode="736F45BA-01C2-45C9-98AF-58170F4E9B5D"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Easy FB Soft is already installed. Uninstall it first to install this version." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="installer/EasyFbSoft.ico" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/kenanwahbeh/FbGateway" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/kenanwahbeh/FbGateway" />

    <!--
      The app needs a desktop session: it is a WPF window that hosts
      the gateway, so a server core install is not a target.
    -->
    <Launch Condition="Installed OR VersionNT &gt;= 603"
            Message="Easy FB Soft requires Windows 8.1 or later." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Easy FB Soft" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Easy FB Soft" />
    </StandardDirectory>

    <Feature Id="Main" Title="Easy FB Soft" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      Harvests the whole published folder; no manual file list.

      Include is relative to *this file*, not to the directory wix was
      launched from, so the repo root is one level up. Note that the
      Icon above is the other way round: SourceFile is relative to the
      launch directory. That inconsistency is WiX's, not a typo here,
      and the two must not be made to match.

      Getting Include wrong is silent -- WiX only warns that zero files
      were harvested and still writes a perfectly valid installer, which
      is how 1.0.0 shipped a 48 KB .msi that installed nothing but a
      Start Menu shortcut. The build passes -wx8600 and -wx8601 to turn
      those warnings into errors so it cannot happen again.
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="../$(var.PublishDir)/**" />
    </ComponentGroup>

    <Component Id="StartMenuShortcut"
               Directory="AppMenuFolder"
               Guid="914069B5-97EC-41E4-BE3B-D6EA012353DD">

      <Shortcut Id="AppShortcut"
                Name="Easy FB Soft"
                Description="HTTP gateway for Firebird databases"
                Target="[INSTALLFOLDER]EasyFbSoft.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />

      <RemoveFolder Id="RemoveAppMenuFolder"
                    Directory="AppMenuFolder"
                    On="uninstall" />

      <RegistryValue Root="HKMU"
                     Key="Software\EasyFbSoft"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />

    </Component>

  </Package>

</Wix>
