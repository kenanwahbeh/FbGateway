<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI definition for ByteBridge.

  Built by .github/workflows/release.yml, which passes the version
  from the git tag and the folder to package:

    wix build installer/Package.wxs -arch x64 -wx8600 -wx8601 ^
      -pdbtype none -d Version=1.2.3 -d PublishDir=publish ^
       -o ByteBridge-1.2.3-x64.msi

  The same file builds both distributions; only PublishDir differs.
  They share one product identity on purpose, so a machine ends up
  with one ByteBridge rather than two competing installs. Switching
  between them at the same version means uninstalling first, because
  an MSI major upgrade will not replace an equal version.

  UpgradeCode identifies the product across every release and must
  never change; changing it would make new versions install beside
  the old ones instead of upgrading them.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="ByteBridge"
           Manufacturer="ByteBridge"
           Version="$(var.Version)"
           UpgradeCode="736F45BA-01C2-45C9-98AF-58170F4E9B5D"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ByteBridge is already installed. Uninstall it first to install this version." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="installer/EasyFbSoft.ico" />

    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/kenanwahbeh/ByteBridge" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/kenanwahbeh/ByteBridge" />

    <!--
      An OS floor, nothing more. Server Core is now a supported target:
      the gateway runs in a service, and the executable that installs
      alongside the window configures it from a terminal, so a machine
      with no desktop at all is usable.
    -->
    <Launch Condition="Installed OR VersionNT &gt;= 603"
            Message="ByteBridge requires Windows 8.1 or later." />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="ByteBridge" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="ByteBridge" />
    </StandardDirectory>

    <Feature Id="Main" Title="ByteBridge" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="GatewayService" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!--
      Harvests the whole published folder; no manual file list.

      Include is relative to *this file*, not to the directory wix was
      launched from, so the repo root is one level up. Note that the
      Icon above is the other way round: SourceFile is relative to the
      launch directory. That inconsistency is WiX's, not a typo here,
      and the two must not be made to match.

      Getting Include wrong is silent: WiX only warns that zero files
      were harvested and still writes a perfectly valid installer, which
      is how 1.0.0 shipped a 48 KB .msi that installed nothing but a
      Start Menu shortcut. The build passes -wx8600 and -wx8601 to turn
      those warnings into errors so it cannot happen again.
    -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="../$(var.PublishDir)/**">
        <!--
          Held out of the harvest so it can live in a component of its
          own below. ServiceInstall has to sit in the same component as
          the executable it registers, and a harvested file lands in a
          component whose id is generated and cannot be referred to.
        -->
        <Exclude Files="../$(var.PublishDir)/ByteBridge.Service.exe" />
      </Files>
    </ComponentGroup>

    <!--
      The gateway runs here, not in the window. Registering it as a
      service is what lets it start with the machine and keep serving
      with nobody signed in, which is the only arrangement that works on
      a Windows Server with no interactive session.

      Note the path: Source is relative to the directory wix was
      launched from, while the Include above is relative to this file.
      That is WiX's inconsistency, checked rather than assumed, and the
      two must not be made to match.
    -->
    <Component Id="GatewayService"
               Directory="INSTALLFOLDER"
               Guid="5C1D7A64-9E0B-4E6E-9E2A-2F4C6B8D1A37">

      <File Id="ServiceExecutable"
            Source="$(var.PublishDir)/ByteBridge.Service.exe"
            KeyPath="yes" />

      <!--
        LocalSystem because the gateway must run without a signed-in
        user, and because reserving its HTTP prefix and locking down the
        settings folder both need that level of rights.
      -->
      <ServiceInstall Id="GatewayServiceInstall"
                      Name="ByteBridge"
                      DisplayName="ByteBridge Gateway"
                      Description="Serves the ByteBridge HTTP gateway over the configured Firebird databases, so it runs without anyone signed in."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes" />

      <!--
        Stop="both" stops it on uninstall and on upgrade, which is what
        frees the executable so the new one can replace it.
      -->
      <ServiceControl Id="GatewayServiceControl"
                      Name="ByteBridge"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />

    </Component>

    <Component Id="StartMenuShortcut"
               Directory="AppMenuFolder"
               Guid="914069B5-97EC-41E4-BE3B-D6EA012353DD">

      <Shortcut Id="AppShortcut"
                Name="ByteBridge"
                Description="HTTP gateway for Firebird databases"
                 Target="[INSTALLFOLDER]ByteBridge.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />

      <RemoveFolder Id="RemoveAppMenuFolder"
                    Directory="AppMenuFolder"
                    On="uninstall" />

      <RegistryValue Root="HKMU"
                      Key="Software\ByteBridge"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />

    </Component>

  </Package>

</Wix>
