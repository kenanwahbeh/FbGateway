<Window x:Class="ByteBridge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="500"
        Height="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SettingsTitleTextBlock"
                   Grid.Row="0"
                   Text="Settings"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">

            <!-- Language -->
            <Border Padding="16"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="#DCDCDC"
                    Margin="0,0,0,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="LanguageTextBlock"
                                   Text="Language"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="LanguageHintTextBlock"
                                   Text="Select the display language"
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ComboBox x:Name="LanguageComboBox"
                              Grid.Column="1"
                              Width="150"
                              Padding="8,7"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en" IsSelected="True"/>
                        <ComboBoxItem Content="العربية" Tag="ar"/>
                    </ComboBox>
                </Grid>

            </Border>

            <!-- Auto Start -->
            <Border Padding="16"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="#DCDCDC">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="AutoStartTextBlock"
                                   Text="Start with Windows"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="AutoStartHintTextBlock"
                                   Text="ByteBridge will start automatically when you log in."
                                   FontSize="12"
                                   Foreground="Gray"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <CheckBox x:Name="AutoStartCheckBox"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Checked="AutoStartCheckBox_Changed"
                              Unchecked="AutoStartCheckBox_Changed"/>
                </Grid>

            </Border>

        </StackPanel>

        <Button x:Name="DoneButton"
                Grid.Row="2"
                Content="Done"
                Padding="25,9"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                Click="DoneButton_Click"/>

    </Grid>

</Window>
