<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    Shipping metadata.

    Version is overridden by the release workflow from the git tag
    (-p:Version=...), so the value here is only what a local build
    stamps. Company and Product show up in the installed program's
    Add/Remove Programs entry and in the file properties.

  -->
  <PropertyGroup>
    <AssemblyName>ByteBridge</AssemblyName>
    <RootNamespace>ByteBridge</RootNamespace>
    <Product>ByteBridge</Product>
    <Company>ByteBridge</Company>
    <Description>HTTP gateway for Firebird databases</Description>
    <Copyright>Copyright © ByteBridge</Copyright>
    <Version>1.0.0</Version>
    <ApplicationIcon>installer/EasyFbSoft.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="core/ByteBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

  <!--
    This project sits at the repo root, so the SDK's default glob picks
    up every .cs file under it. Every sibling project has to be removed
    by hand or its sources get compiled into the app a second time, and
    the duplicate-type errors that causes point at the wrong file.

    Add a line here whenever a new project is added to the repo, or move
    this project out of the root and be done with it.
  -->
  <ItemGroup>
    <Compile Remove="tests/**;core/**;service/**" />
    <None Remove="tests/**;core/**;service/**" />
  </ItemGroup>

</Project>
